<!-- add header -->
<%- include('includes/_header') %>
<!-- end header -->

<!-- Main section -->
<main id="main" class="error-page">
    <div class="error-container">
        <div class="error-content">
            <!-- Error Icon -->
            <div class="error-icon">
                <% if (statusCode >= 500) { %>
                    <i class="fas fa-exclamation-triangle"></i>
                <% } else if (statusCode === 404) { %>
                    <i class="fas fa-search"></i>
                <% } else { %>
                    <i class="fas fa-times-circle"></i>
                <% } %>
            </div>

            <!-- Error Code -->
            <h1 class="error-code"><%= statusCode %></h1>

            <!-- Error Message -->
            <h2 class="error-message">
                <% if (statusCode === 404) { %>
                    Trang không tìm thấy
                <% } else if (statusCode === 500) { %>
                    Lỗi máy chủ
                <% } else if (statusCode === 400) { %>
                    Yêu cầu không hợp lệ
                <% } else if (statusCode === 401) { %>
                    Không có quyền truy cập
                <% } else if (statusCode === 403) { %>
                    Bị cấm truy cập
                <% } else { %>
                    Có lỗi xảy ra
                <% } %>
            </h2>

            <!-- Error Description -->
            <p class="error-description">
                <%= message || 'Đã xảy ra lỗi không mong muốn. Vui lòng thử lại sau.' %>
            </p>

            <!-- Error Details (Development only) -->
            <% if (stack && process.env.NODE_ENV === 'development') { %>
                <div class="error-details">
                    <h3>Chi tiết lỗi (Development):</h3>
                    <pre class="error-stack"><%= stack %></pre>
                </div>
            <% } %>

            <!-- Error Info -->
            <div class="error-info">
                <p><strong>URL:</strong> <%= url %></p>
                <p><strong>Thời gian:</strong> <%= new Date(timestamp).toLocaleString('vi-VN') %></p>
            </div>

            <!-- Action Buttons -->
            <div class="error-actions">
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
                <a href="/manage" class="btn btn-secondary">
                    <i class="fas fa-list"></i> Quản lý thuốc
                </a>
                <button onclick="history.back()" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </button>
            </div>

            <!-- Help Section -->
            <div class="error-help">
                <h3>Bạn có thể thử:</h3>
                <ul>
                    <li>Kiểm tra lại URL</li>
                    <li>Làm mới trang</li>
                    <li>Quay lại trang trước</li>
                    <li>Liên hệ quản trị viên nếu lỗi vẫn tiếp tục</li>
                </ul>
            </div>
        </div>
    </div>
</main>

<style>
.error-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.error-container {
    max-width: 800px;
    width: 100%;
    text-align: center;
}

.error-content {
    background: #fff;
    border-radius: 10px;
    padding: 40px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.error-icon {
    font-size: 4rem;
    margin-bottom: 20px;
}

.error-icon i {
    color: #e74c3c;
}

.error-code {
    font-size: 6rem;
    font-weight: bold;
    color: #e74c3c;
    margin: 0;
    line-height: 1;
}

.error-message {
    font-size: 2rem;
    color: #2c3e50;
    margin: 20px 0;
}

.error-description {
    font-size: 1.1rem;
    color: #7f8c8d;
    margin-bottom: 30px;
    line-height: 1.6;
}

.error-details {
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    padding: 20px;
    margin: 20px 0;
    text-align: left;
}

.error-details h3 {
    color: #495057;
    margin-bottom: 10px;
}

.error-stack {
    background: #2c3e50;
    color: #ecf0f1;
    padding: 15px;
    border-radius: 5px;
    overflow-x: auto;
    font-size: 0.9rem;
    white-space: pre-wrap;
}

.error-info {
    background: #f8f9fa;
    border-radius: 5px;
    padding: 15px;
    margin: 20px 0;
    text-align: left;
}

.error-info p {
    margin: 5px 0;
    color: #6c757d;
}

.error-actions {
    margin: 30px 0;
}

.error-actions .btn {
    display: inline-block;
    padding: 12px 24px;
    margin: 5px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: 500;
    transition: all 0.3s ease;
}

.btn-primary {
    background: #007bff;
    color: white;
    border: 2px solid #007bff;
}

.btn-primary:hover {
    background: #0056b3;
    border-color: #0056b3;
}

.btn-secondary {
    background: #6c757d;
    color: white;
    border: 2px solid #6c757d;
}

.btn-secondary:hover {
    background: #545b62;
    border-color: #545b62;
}

.btn-outline {
    background: transparent;
    color: #007bff;
    border: 2px solid #007bff;
}

.btn-outline:hover {
    background: #007bff;
    color: white;
}

.error-help {
    background: #e9ecef;
    border-radius: 5px;
    padding: 20px;
    margin-top: 30px;
    text-align: left;
}

.error-help h3 {
    color: #495057;
    margin-bottom: 15px;
}

.error-help ul {
    list-style: none;
    padding: 0;
}

.error-help li {
    padding: 5px 0;
    color: #6c757d;
}

.error-help li:before {
    content: "✓ ";
    color: #28a745;
    font-weight: bold;
}

@media (max-width: 768px) {
    .error-content {
        padding: 20px;
    }
    
    .error-code {
        font-size: 4rem;
    }
    
    .error-message {
        font-size: 1.5rem;
    }
    
    .error-actions .btn {
        display: block;
        width: 100%;
        margin: 10px 0;
    }
}
</style>

<!-- add footer -->
<%- include('includes/_footer') %>
<!-- end footer -->
